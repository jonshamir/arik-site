<article class="paper-card">
  <div class="paper-thumbnail">
    <a href="/papers/{{ paper.slug }}/">
      <img src="{{ paper.thumbnail }}" alt="{{ paper.title }}" />
    </a>
  </div>
  <div class="paper-info">
    <h3><a href="/papers/{{ paper.slug }}/">{{ paper.title }}</a></h3>
    <p class="paper-authors">{{ paper.authors | join(', ') }}</p>
    <p class="paper-venue">{{ paper.venue }} {{paper.volume}}{% if paper.number %} ({{paper.number}}) {% endif %}{% if paper.pages %}: {{ paper.pages }}{% endif %}, {{ paper.year }}</p>
    <button class="bibtex-btn btn btn-small">BibTeX</button>
    <dialog class="bibtex-dialog">
      <div class="bibtex-dialog-content">
        <pre>{{ paper | toBibtex }}</pre>
        <div class="bibtex-dialog-actions">
          <button class="bibtex-copy-btn btn btn-small">Copy</button>
          <button class="bibtex-close-btn btn btn-small">Close</button>
        </div>
      </div>
    </dialog>
  </div>
</article>
